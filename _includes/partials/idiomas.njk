{#- Selector de idioma: un desplegable (<details>) con enlaces reales, nunca
    un <select> con JS. Funciona sin JavaScript (details abre y cierra solo);
    el script de base.njk solo lo cierra al pulsar fuera o Escape. Cada
    enlace lleva hreflang y lang; el actual, aria-current. Apunta a la
    página equivalente o a la home del idioma si esta página no existe en él.
    `formato` = "nav" | "pie". Solo se pinta con dos o más idiomas vivos. -#}
{%- if idiomas.live.length > 1 -%}
{%- set menu %}<details class="idioma"><summary aria-label="{{ t.idiomas_label }}: {{ t.label }}"><span aria-hidden="true">🌐</span> {{ t.label }} <span class="idioma-flecha" aria-hidden="true">▾</span></summary>
<ul>
{%- for code in idiomas.live %}
<li><a href="{{ collections.routes | destinoIdioma(key, code) | enlace(pre) }}" hreflang="{{ code }}" lang="{{ code }}"{% if code == lang %} aria-current="true"{% endif %}>{{ i18n[code].label }}</a></li>
{%- endfor %}
</ul>
</details>{% endset %}
{%- if formato == "nav" %}
<li class="idiomas">{{ menu | safe }}</li>
{%- else %}
<span class="idiomas">{{ menu | safe }}</span>
{%- endif %}
{%- endif -%}
