{%- set pre = base if base is defined else (page.url | relprefix) -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title | safe }}</title>
<meta name="description" content="{{ description | safe }}">
{%- if head != "minimo" %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{#- hreflang solo si la página existe en dos o más idiomas vivos: recíproco,
    autorreferencial y con x-default al idioma base. Lo genera routes, así
    que no puede quedar sin retorno. #}
{%- set alts = collections.routes | alternates(key, idiomas.live) %}
{%- if alts.length > 1 %}
{%- for a in alts %}
<link rel="alternate" hreflang="{{ a.lang }}" href="{{ site.url }}{{ a.url }}">
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ collections.routes | xdefault(key, site.default_lang) }}">
{%- endif %}
{%- endif %}
{#- Un idioma en draft se despliega (para revisarlo en su prefijo) pero no se
    indexa: lleva precios y datos PENDIENTE. Al pasar a live, el robots de
    cada página vuelve a mandar. #}
<meta name="robots" content="{% if t.status != 'live' %}noindex, follow{% else %}{{ robots or 'index, follow, max-image-preview:large' }}{% endif %}">
{%- if head == "minimo" %}
<meta name="googlebot" content="{{ robots }}">
{%- endif %}
<meta name="author" content="{{ site.author.name }}">
<meta name="theme-color" content="{{ site.theme_color }}">
<meta name="color-scheme" content="dark">
{%- if head != "minimo" %}
<meta property="og:site_name" content="{{ site.og_site_name }}">
<meta property="og:locale" content="{{ t.locale }}">
{%- if alts.length > 1 %}{% for a in alts %}{% if a.lang != lang %}
<meta property="og:locale:alternate" content="{{ i18n[a.lang].locale }}">
{%- endif %}{% endfor %}{% endif %}
<meta property="og:type" content="{{ og.type }}">
<meta property="og:title" content="{{ og.title | safe }}">
<meta property="og:description" content="{{ description | safe }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/media/{{ lang }}/{{ og.image }}">
<meta property="og:image:secure_url" content="{{ site.url }}/media/{{ lang }}/{{ og.image }}">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ og.alt | safe }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="{{ site.twitter }}">
<meta name="twitter:creator" content="{{ site.twitter }}">
<meta name="twitter:title" content="{{ og.title | safe }}">
<meta name="twitter:description" content="{{ description | safe }}">
<meta name="twitter:image" content="{{ site.url }}/media/{{ lang }}/{{ og.image }}">
<meta name="twitter:image:alt" content="{{ og.alt | safe }}">
{%- endif %}
<link rel="icon" href="{{ pre }}favicon.ico" sizes="32x32">
<link rel="icon" href="{{ pre }}favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="{{ pre }}apple-touch-icon.png">
{%- if preload_cover %}
<link rel="preload" as="image" href="{{ pre }}media/{{ edition.cover }}" fetchpriority="high">
{%- endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;700&display=swap">
<style>
{% if css_base != false %}{% include "css/base.css" %}{% endif %}{% if css %}{% include "css/" + css + ".css" %}{% endif %}</style>
{%- if book_jsonld %}
{{ edition | jsonldBook(site, page.url, lang) | safe }}
{%- endif %}
{%- if jsonld %}
{{ jsonld | trim | safe }}
{%- endif %}
{%- if jsonld_site %}
{{ site | jsonldSite(lang) | safe }}
{%- endif %}
<script>document.documentElement.className="js";</script>
<script>
(function () {
  function ev(nombre, props) {
    try {
      if (typeof window.plausible === "function") { window.plausible(nombre, { props: props || {} }); return; }
      if (window.umami && typeof window.umami.track === "function") { window.umami.track(nombre, props || {}); return; }
      if (typeof window.gtag === "function") { window.gtag("event", nombre, props || {}); return; }
    } catch (e) {}
  }
  document.addEventListener("click", function (e) {
    var t = e.target;
    var a = t && t.closest ? t.closest("[data-evento]") : null;
    if (a) ev(a.getAttribute("data-evento"), { destino: a.getAttribute("href") || "" });
  }, { passive: true });
})();
</script>
{%- if idiomas.live.length > 1 %}
<script>
/* Desplegable de idioma: se cierra al pulsar fuera o con Escape. Sin JS
   sigue funcionando (details abre y cierra solo). */
(function () {
  function cerrar(salvo) {
    var abiertos = document.querySelectorAll("details.idioma[open]");
    for (var i = 0; i < abiertos.length; i++) if (abiertos[i] !== salvo) abiertos[i].removeAttribute("open");
  }
  document.addEventListener("click", function (e) { cerrar(e.target.closest ? e.target.closest("details.idioma") : null); });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape") cerrar(null); });
})();
</script>
<script>
/* Banner «esta página está disponible en tu idioma». Nunca redirige: Googlebot
   rastrea con Accept-Language en-US y un salto automático desindexaría la
   raíz. Se descarta con un clic y localStorage lo recuerda. */
(function () {
  try { if (localStorage.getItem("banner-idioma") === "no") return; } catch (e) {}
  var textos = {{ idiomas.banner | dump | safe }};
  var actual = document.documentElement.lang;
  var alts = {}, links = document.querySelectorAll('link[rel="alternate"][hreflang]');
  for (var i = 0; i < links.length; i++) { var h = links[i].getAttribute("hreflang"); if (h !== "x-default") alts[h] = links[i].getAttribute("href"); }
  var prefs = navigator.languages || [navigator.language || ""], elegido = null;
  for (var j = 0; j < prefs.length && !elegido; j++) {
    var c = String(prefs[j] || "").slice(0, 2).toLowerCase();
    if (c && c !== actual && alts[c] && textos[c]) elegido = c;
  }
  if (!elegido) return;
  function pintar() {
    var div = document.createElement("div"); div.className = "banner-idioma"; div.lang = elegido; div.setAttribute("role", "status");
    var a = document.createElement("a"); a.href = alts[elegido]; a.hreflang = elegido; a.textContent = textos[elegido].texto;
    var b = document.createElement("button"); b.type = "button"; b.textContent = "×"; b.setAttribute("aria-label", textos[elegido].cerrar);
    b.addEventListener("click", function () { div.remove(); try { localStorage.setItem("banner-idioma", "no"); } catch (e) {} });
    div.appendChild(a); div.appendChild(b); document.body.insertBefore(div, document.body.firstChild);
  }
  if (document.body) pintar(); else document.addEventListener("DOMContentLoaded", pintar);
})();
</script>
{%- endif %}
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cloudflare_token }}"}'></script>
</head>
<body>
<a class="saltar" href="#contenido">{{ t.saltar }}</a>
{% include "partials/nav.njk" %}
{%- if edition and edition.status != "live" and t.beta %}
<div class="contenedor" style="padding-top:22px"><div class="aviso" role="note"><strong>{{ t.beta.titulo }}</strong> {{ t.beta.texto }} <a href="{{ t.beta.github_url }}" rel="noopener" data-evento="beta-github">{{ t.beta.github }}</a> · <a href="https://x.com/jvela" rel="me noopener" data-evento="beta-x">{{ t.beta.x }}</a>.</div></div>
{%- endif %}
{{ content | safe }}{% include "partials/footer.njk" %}
</body>
</html>
